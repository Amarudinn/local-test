# Ruang Debat Environment Variables
# Copy this file to .env.local and update with your actual values
# See ENVIRONMENT_VARIABLES.md for detailed documentation

# ============================================
# GenLayer Blockchain Configuration
# ============================================
# RPC endpoint for GenLayer network
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Chain ID for GenLayer network (Studio: 61999)
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/<your-project>/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase anonymous/public key (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key (⚠️ KEEP SECRET - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# Privy Authentication
# ============================================
# Get this from: https://dashboard.privy.io
# Make sure to add your domain to allowed origins in Privy dashboard
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# ============================================
# Application Configuration
# ============================================
# Node environment (development, production, test)
NODE_ENV=development

# Base URL of your application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Monitoring and Logging (Optional)
# ============================================

# Sentry Error Tracking
# Get your DSN from: https://sentry.io
# Leave empty to disable error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics
# Get your Measurement ID from: https://analytics.google.com
# Leave empty to disable analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ============================================
# Security Configuration (Production Only)
# ============================================

# NextAuth secret for session encryption
# Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET=

# NextAuth callback URL (should match NEXT_PUBLIC_APP_URL)
# NEXTAUTH_URL=http://localhost:3000

# Cron Job Secret (for background sync)
# Generate a random secret: openssl rand -base64 32
# Used to authenticate background job API calls
CRON_SECRET=your-secret-key-here-change-this-in-production

# ============================================
# Feature Flags
# ============================================
# Enable/disable analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable/disable error tracking
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false

# Enable/disable performance monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false

# ============================================
# Advanced Configuration (Optional)
# ============================================

# Rate limiting (requests per window)
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# Database connection pool
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# ============================================
# Notes
# ============================================
# - Never commit .env.local to version control
# - Use different values for development and production
# - Keep SUPABASE_SERVICE_ROLE_KEY secret
# - See ENVIRONMENT_VARIABLES.md for detailed documentation
# - See DEPLOYMENT_GUIDE.md for production setup
