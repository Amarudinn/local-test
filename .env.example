# RPC endpoint for GenLayer network
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Chain ID for GenLayer network (Studio: 61999)
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999

# Private key for server-side operations (cron jobs)
# Get this from your GenLayer wallet - needed for AI evaluation
# Format: 0x... (66 characters hex string)
GENLAYER_PRIVATE_KEY=your_genlayer_private_key

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase anonymous/public key (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key (⚠️ KEEP SECRET - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Get this from: https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Node environment (development, production, test)
NODE_ENV=development

# Base URL of your application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Monitoring and Logging (Optional)
# ============================================

# Sentry Error Tracking
# Get your DSN from: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cron Job Secret (for background sync)
# Generate a random secret: openssl rand -base64 32
# Used to authenticate background job API calls
CRON_SECRET=your-secret-key-here-change-this-in-production

# Enable/disable analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable/disable error tracking
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false

# Enable/disable performance monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false
