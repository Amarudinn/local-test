# Debate Room Production Environment Variables
# Copy this file to .env.production and update with your actual production values

# ============================================
# GenLayer Blockchain Configuration
# ============================================
# Production: Use GenLayer mainnet RPC when available
# For now: Use Studio RPC for production deployment
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999

# Note: When GenLayer mainnet launches, update to:
# NEXT_PUBLIC_GENLAYER_RPC_URL=https://mainnet.genlayer.com/api
# NEXT_PUBLIC_GENLAYER_CHAIN_ID=<mainnet_chain_id>

# ============================================
# Supabase Configuration (PRODUCTION)
# ============================================
# IMPORTANT: Use your PRODUCTION Supabase project
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key

# ============================================
# Privy Authentication (PRODUCTION)
# ============================================
# IMPORTANT: Configure production domain in Privy dashboard
# Get this from: https://dashboard.privy.io
# Make sure to add your production domain to allowed origins
NEXT_PUBLIC_PRIVY_APP_ID=your_production_privy_app_id

# ============================================
# Monitoring and Logging (REQUIRED FOR PRODUCTION)
# ============================================

# Sentry Error Tracking (Highly Recommended)
# Get your DSN from: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your-production-sentry-dsn@sentry.io/project-id

# Google Analytics (Optional)
# Get your Measurement ID from: https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# ============================================
# Security Configuration
# ============================================
# IMPORTANT: Set these for production security
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-production-domain.com

# ============================================
# Rate Limiting (Optional but Recommended)
# ============================================
# Configure rate limits for API endpoints
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Database Connection Pool (Optional)
# ============================================
# Adjust based on your Supabase plan
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# Vercel Configuration (Auto-populated by Vercel)
# ============================================
# These are automatically set by Vercel, no need to configure manually
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-app.vercel.app
# VERCEL_GIT_COMMIT_SHA=<commit-sha>
